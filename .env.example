# ─────────────────────────────────────────────────────────────
# BEXEL Growth Platform — Environment configuration (EXAMPLE)
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ─────────────────────────────────────────────────────────────

# MySQL connection string used by Prisma.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/bexel_growth"

# Public URL of the app (used in emails, sitemap, OG tags).
APP_URL="http://localhost:3000"

# ── Admin authentication (server-side credentials login) ──────
# Email used to log into /admin.
ADMIN_EMAIL="admin@bexel-demo.com"
# bcrypt hash of the admin password.
# Generate one with:  npm run hash -- "YourStrongPassword"
# NOTE: escape every '$' as '\$' so Next.js does NOT treat the hash as
# environment-variable references (otherwise the hash is silently corrupted).
# Demo default below is the bcrypt hash of: "BexelDemo2026!"
ADMIN_PASSWORD_HASH="\$2a\$10\$PDzUZ7fyRuwuTdvhvB/HQuKM5PBUOv9zEe01O7HXrMZ4sQewdPSOi"

# Secret used to sign the admin session JWT (min 32 chars).
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ── Email (development log by default) ────────────────────────
# Address the platform sends notifications from.
EMAIL_FROM="BEXEL Growth <no-reply@bexel-demo.com>"
# Internal sales inbox that receives HOT lead notifications.
SALES_EMAIL="sales@bexel-demo.com"
# Optional — provider API key. When empty, emails are logged to console only.
RESEND_API_KEY=""
